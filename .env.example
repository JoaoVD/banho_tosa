# Banco (local: npm run db:local up)
DATABASE_URL=postgres://postgres@localhost:54329/postgres
# Conexão com privilégios de serviço (worker e webhook). Local: igual ao DATABASE_URL
SUPABASE_SERVICE_DATABASE_URL=postgres://postgres@localhost:54329/postgres
# Autenticação: dev | supabase
AUTH_MODE=dev
AUTH_SECRET=troque-esta-chave-em-producao
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WhatsApp: fake | evolution
WHATSAPP_PROVIDER=fake
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WEBHOOK_SECRET=troque-este-segredo
SUPABASE_SERVICE_ROLE_KEY=
